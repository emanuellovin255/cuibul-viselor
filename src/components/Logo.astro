---
import { url } from '../lib/url';
import { general } from '../lib/continut';

/**
 * Logoul pensiunii (public/logo.svg), desenat vectorial după logoul original, mereu în culorile lui.
 * badge: îl așază pe o insignă crem, ca să se vadă peste video, poze și fundaluri închise.
 */
interface Props {
  class?: string;
  badge?: boolean;
  link?: boolean;
}

const { class: className = '', badge = false, link = true } = Astro.props;
const Tag = link ? 'a' : 'span';
---

<Tag
  href={link ? url('/') : undefined}
  class:list={['brand-logo inline-flex shrink-0', badge && 'brand-logo-badge', className]}
  aria-label={link ? `${general.nume} – ${general.alias}, pagina principală` : undefined}
>
  <svg viewBox="9 9 1536 930" class="h-full w-auto" role="img" aria-label={`${general.numeScurt} – ${general.alias}`}>
    <use href={url('/logo.svg#logo')}></use>
  </svg>
</Tag>
