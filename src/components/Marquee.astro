---
interface Props {
  words: string[];
  class?: string;
}

const { words, class: className = '' } = Astro.props;
const row = [...words, ...words];
---

<div class:list={['relative overflow-hidden py-10 md:py-14', className]} aria-hidden="true">
  <div class="marquee-track flex w-max items-center">
    {
      [0, 1].map(() => (
        <div class="flex items-center">
          {row.map((w) => (
            <span class="flex items-center">
              <span class="whitespace-nowrap px-6 font-serif text-[clamp(3rem,8vw,7.5rem)] leading-none tracking-[-0.03em] md:px-10">
                {w}
              </span>
              <svg viewBox="0 0 24 24" class="h-6 w-6 shrink-0 text-brass-500 md:h-9 md:w-9" fill="currentColor">
                <path d="M12 0c.6 6.3 5.7 11.4 12 12-6.3.6-11.4 5.7-12 12-.6-6.3-5.7-11.4-12-12C6.3 11.4 11.4 6.3 12 0Z" />
              </svg>
            </span>
          ))}
        </div>
      ))
    }
  </div>
</div>
