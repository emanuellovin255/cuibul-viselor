---
import { Ticket, CreditCard } from '@lucide/astro';
import { general } from '../lib/continut';

const v = general.benzaTichete;
---

{v.afiseaza !== false && (
<section class="bg-brass-400 text-forest-900">
  <div class="container-x flex flex-col items-start gap-8 py-14 md:flex-row md:items-center md:justify-between md:py-16">
    <div class="flex items-center gap-5" data-reveal>
      <span class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full border border-forest-900/25">
        <Ticket size={28} stroke-width={1.3} />
      </span>
      <div>
        <p class="font-serif text-[clamp(1.6rem,3vw,2.4rem)] leading-tight">{v.titlu}</p>
        <p class="mt-1 text-forest-900/75">{v.subtitlu}</p>
      </div>
    </div>
    <p class="flex max-w-md items-start gap-3 text-sm leading-relaxed text-forest-900/80" data-reveal>
      <CreditCard size={18} stroke-width={1.5} class="mt-0.5 shrink-0" />
      {v.text}
    </p>
  </div>
</section>
)}
