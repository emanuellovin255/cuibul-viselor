---
import { facilities } from '../data/facilities';

interface Props {
  limit?: number;
  dark?: boolean;
}

const { limit, dark = false } = Astro.props;
const items = limit ? facilities.slice(0, limit) : facilities;
---

<ul class:list={['grid gap-px overflow-hidden rounded-[1.75rem] sm:grid-cols-2 lg:grid-cols-4', dark ? 'bg-cream-100/10' : 'bg-forest-900/10']}>
  {
    items.map((f, i) => (
      <li
        class:list={[
          'group relative p-7 transition-colors duration-500 md:p-9',
          dark ? 'bg-forest-900 hover:bg-forest-800' : 'bg-cream-100 hover:bg-cream-50',
        ]}
        data-reveal
        data-delay={(i % 4) * 0.06}
      >
        <span
          class:list={[
            'flex h-14 w-14 items-center justify-center rounded-full border transition-all duration-500 group-hover:-translate-y-1',
            dark
              ? 'border-cream-100/15 text-brass-300 group-hover:border-brass-400'
              : 'border-forest-900/15 text-forest-700 group-hover:border-brass-500 group-hover:text-brass-600',
          ]}
        >
          <f.icon size={24} stroke-width={1.3} />
        </span>
        <h3 class:list={['mt-7 font-serif text-[1.45rem] leading-tight', dark ? 'text-cream-50' : 'text-forest-900']}>{f.title}</h3>
        <p class:list={['mt-3 text-[0.93rem] leading-relaxed', dark ? 'text-cream-100/60' : 'text-muted']}>{f.text}</p>
      </li>
    ))
  }
</ul>
