---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Gallery, { type GalleryItem } from '../components/Gallery.astro';
import CTASection from '../components/CTASection.astro';
import { rooms } from '../data/rooms';
import { dishes } from '../data/dishes';
import { photos, photo } from '../lib/photos';
import { galerie, em } from '../lib/continut';

const cats = galerie.categorii.filter((c) => c.id && c.eticheta);
const byId = new Map(cats.map((c) => [c.id, c]));
const items: GalleryItem[] = [
  ...cats.flatMap((c) =>
    (c.foldere ?? []).filter(Boolean).flatMap((folder) => photos(folder).map((src) => ({ src, alt: c.descriere || c.eticheta, cat: c.id }))),
  ),
  ...(byId.has('camere') ? rooms.flatMap((r) => photos(r.folder).map((src) => ({ src, alt: r.name, cat: 'camere' }))) : []),
  ...(byId.has('restaurant') ? dishes.map((d) => ({ src: d.src, alt: d.alt, caption: d.name, cat: 'restaurant' })) : []),
];

// Amestecă determinist categoriile pentru „Toate”, ca galeria să nu înceapă cu 20 de poze de exterior la rând.
const order = cats.map((c) => c.id);
const buckets = new Map<string, GalleryItem[]>();
items.forEach((it) => {
  const key = it.cat ?? order[0];
  buckets.set(key, [...(buckets.get(key) ?? []), it]);
});
const mixed: GalleryItem[] = [];
while ([...buckets.values()].some((b) => b.length)) {
  for (const cat of order) {
    const next = buckets.get(cat)?.shift();
    if (next) mixed.push(next);
  }
}

const de = (n: number) => (n % 100 === 0 || n % 100 >= 20 ? 'de ' : '');

const filters = cats.map((c) => ({ id: c.id, label: c.eticheta }));
const p = galerie.pagina;
---

<BaseLayout title={p.titluSeo} description={p.descriereSeo} image={photo(p.poza)}>
  <PageHero
    eyebrow={p.eticheta}
    crumb="Galerie"
    title={em(p.titlu, 'text-brass-300')}
    subtitle={`${mixed.length} ${de(mixed.length)}${p.subtitlu}`}
    image={photo(p.poza)}
    alt="Pensiunea Cuibul Viselor, cu munții Văii Cernei în fundal"
  />

  <section class="bg-cream-100 py-20 md:py-28">
    <div class="container-x">
      <Gallery items={mixed} filters={filters} />
    </div>
  </section>

  <CTASection image={photo(p.pozaFinal)} />
</BaseLayout>
