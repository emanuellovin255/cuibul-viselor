---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Gallery, { type GalleryItem } from '../components/Gallery.astro';
import CTASection from '../components/CTASection.astro';
import { rooms } from '../data/rooms';
import { photos, photo } from '../lib/photos';

const items: GalleryItem[] = [
  ...photos('exterior').map((src) => ({ src, alt: 'Pensiunea Cuibul Viselor, la poalele munților', cat: 'exterior' })),
  ...photos('terasa').map((src) => ({ src, alt: 'Terasă cu vedere spre grădină', cat: 'exterior' })),
  ...photos('gradina').map((src) => ({ src, alt: 'Grădina Magic Garden', cat: 'gradina' })),
  ...photos('rau').map((src) => ({ src, alt: 'Râul Cerna, lângă pensiune', cat: 'gradina' })),
  ...rooms.flatMap((r) => photos(r.folder).map((src) => ({ src, alt: r.name, cat: 'camere' }))),
  ...photos('camere/altele').map((src) => ({ src, alt: 'Cameră la Pensiunea Cuibul Viselor', cat: 'camere' })),
  ...photos('restaurant').map((src) => ({ src, alt: 'Restaurantul La Johnny', cat: 'restaurant' })),
  ...photos('imprejurimi').map((src) => ({ src, alt: 'Împrejurimile Băilor Herculane', cat: 'imprejurimi' })),
];

// Amestecă determinist categoriile pentru „Toate”, ca galeria să nu înceapă cu 20 de poze de exterior la rând.
const order = ['exterior', 'camere', 'gradina', 'restaurant', 'camere', 'imprejurimi'];
const buckets = new Map<string, GalleryItem[]>();
items.forEach((it) => {
  const key = it.cat ?? 'exterior';
  buckets.set(key, [...(buckets.get(key) ?? []), it]);
});
const mixed: GalleryItem[] = [];
while ([...buckets.values()].some((b) => b.length)) {
  for (const cat of order) {
    const next = buckets.get(cat)?.shift();
    if (next) mixed.push(next);
  }
}

const de = (n: number) => (n % 100 === 0 || n % 100 >= 20 ? 'de ' : '');

const filters = [
  { id: 'exterior', label: 'Pensiunea' },
  { id: 'camere', label: 'Camere' },
  { id: 'gradina', label: 'Grădina & râul' },
  { id: 'restaurant', label: 'Restaurant' },
  { id: 'imprejurimi', label: 'Împrejurimi' },
];
---

<BaseLayout
  title="Galerie foto"
  description="Galerie foto Pensiunea Cuibul Viselor din Băile Herculane: camere, restaurant, grădina Magic Garden, râul Cerna și împrejurimi."
  image={photo('exterior/03')}
>
  <PageHero
    eyebrow="Galerie"
    crumb="Galerie"
    title='Priviți <em class="italic-serif text-brass-300">înainte să veniți</em>'
    subtitle={`${mixed.length} ${de(mixed.length)}fotografii cu pensiunea, camerele, grădina și împrejurimile Băilor Herculane.`}
    image={photo('exterior/03')}
    alt="Curtea interioară a pensiunii, cu munții în fundal"
  />

  <section class="bg-cream-100 py-20 md:py-28">
    <div class="container-x">
      <Gallery items={mixed} filters={filters} />
    </div>
  </section>

  <CTASection image={photo('exterior/05')} />
</BaseLayout>
