---
import { Image } from 'astro:assets';
import { Coffee, Soup, UtensilsCrossed } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Gallery from '../components/Gallery.astro';
import VoucherBand from '../components/VoucherBand.astro';
import CTASection from '../components/CTASection.astro';
import { meals, mealNoteLong } from '../data/site';
import { dishes } from '../data/dishes';
import { photos, photo } from '../lib/photos';
import { restaurant as r, em } from '../lib/continut';
import { icon } from '../lib/icons';

const p = r.pagina;

const mealIcons = [Coffee, Soup, UtensilsCrossed];
const gallery = photos('restaurant').map((src, i) => ({ src, alt: `Restaurantul La Johnny – fotografia ${i + 1}` }));
const dishItems = dishes.map((d) => ({ src: d.src, alt: d.alt, caption: d.name }));
---

<BaseLayout title={p.titluSeo} description={p.descriereSeo} image={photo(p.poza)}>
  <PageHero
    eyebrow={p.eticheta}
    crumb="Restaurant"
    title={em(p.titlu, 'text-brass-300')}
    subtitle={p.subtitlu}
    image={photo(p.poza)}
    alt="Sala restaurantului La Johnny"
  />

  <!-- INTRO -->
  <section class="bg-cream-100 py-24 md:py-36">
    <div class="container-x grid items-center gap-16 lg:grid-cols-12">
      <div class="lg:col-span-6">
        <SectionHeading eyebrow={p.etichetaMese} title={em(p.titluMese)} text={p.textMese} size="md" />

        <p class="mt-8 inline-flex items-center gap-3 rounded-full border border-brass-500/40 bg-brass-300/15 px-5 py-2.5 text-sm font-semibold text-brass-600" data-reveal>
          <UtensilsCrossed size={16} stroke-width={1.6} /> Serviciu {r.serviciu}
        </p>
        <p class="mt-5 max-w-md text-muted" data-reveal>{mealNoteLong}</p>
        {
          p.citat && (
            <figure class="mt-12 border-l-2 border-brass-400 pl-6" data-reveal>
              <blockquote class="font-serif text-2xl italic leading-snug text-forest-900">„{p.citat}”</blockquote>
              <figcaption class="mt-3 text-xs font-bold uppercase tracking-[0.18em] text-muted">
                {p.autorCitat}
              </figcaption>
            </figure>
          )
        }
      </div>
      <div class="grid gap-4 lg:col-span-6">
        {
          meals.map((m, i) => {
            const Icon = mealIcons[i % mealIcons.length];
            return (
              <div
                class:list={[
                  'flex items-start gap-6 rounded-[1.5rem] p-7 md:p-8',
                  i === 1 ? 'bg-forest-900 text-cream-50 lg:translate-x-8' : 'border border-forest-900/10 bg-cream-50',
                ]}
                data-reveal
                data-delay={i * 0.08}
              >
                <span
                  class:list={[
                    'flex h-14 w-14 shrink-0 items-center justify-center rounded-full',
                    i === 1 ? 'bg-brass-300/15 text-brass-300' : 'bg-brass-400/12 text-brass-600',
                  ]}
                >
                  <Icon size={26} stroke-width={1.3} />
                </span>
                <div>
                  <p class:list={['font-serif text-2xl md:text-3xl', i === 1 ? 'text-brass-300' : 'text-forest-800']}>{m.name}</p>
                  <p class:list={['mt-2.5 text-[0.95rem] leading-relaxed', i === 1 ? 'text-cream-100/70' : 'text-muted']}>{m.text}</p>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- IMAGINE LATĂ -->
  <section class="relative h-[80svh] min-h-[480px] overflow-hidden bg-forest-900">
    <div class="absolute inset-x-0 -top-[12%] h-[124%]" data-parallax="10">
      <Image src={photo(p.pozaLata)} alt="Mese aranjate în restaurantul La Johnny" widths={[768, 1280, 1920]} sizes="100vw" class="img-cover" />
    </div>
    <div class="absolute inset-0 bg-forest-950/35"></div>
  </section>

  <!-- PREPARATE -->
  <section class="bg-cream-100 py-24 md:py-36">
    <div class="container-x">
      <SectionHeading eyebrow={p.etichetaBucatarie} title={em(p.titluBucatarie)} text={p.textBucatarie} size="md" />

      <ul class="mt-14 grid gap-3 sm:grid-cols-3 lg:grid-cols-6" data-reveal>
        {
          r.specialitati.filter(Boolean).map((t) => (
            <li class="rounded-full border border-forest-900/12 bg-cream-50 px-5 py-3 text-center text-[0.8rem] font-semibold text-forest-800">
              {t}
            </li>
          ))
        }
      </ul>

      <div class="mt-14">
        <Gallery items={dishItems} />
      </div>

      <p class="mt-10 max-w-2xl text-sm text-muted" data-reveal>
        {p.notaBucatarie}
      </p>
    </div>
  </section>

  <!-- BAR / CONFERINȚE / GRĂTAR -->
  <section class="grain relative bg-forest-900 py-24 text-cream-50 md:py-36">
    <div class="container-x">
      <SectionHeading eyebrow="Și mai mult" title={em(p.titluExtra, 'text-brass-300')} light size="md" />
      <div class="mt-16 grid gap-px overflow-hidden rounded-[1.75rem] bg-cream-100/10 md:grid-cols-3">
        {
          r.extra.map((x) => ({ icon: icon(x.icon), title: x.titlu, text: x.text })).map((f, i) => (
            <div class="bg-forest-900 p-8 md:p-10" data-reveal data-delay={i * 0.08}>
              <f.icon size={30} stroke-width={1.2} class="text-brass-300" />
              <h3 class="mt-10 font-serif text-3xl">{f.title}</h3>
              <p class="mt-4 text-cream-100/65">{f.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- GALERIE -->
  <section class="bg-cream-100 py-24 md:py-36">
    <div class="container-x">
      <div class="mb-14 flex items-end justify-between gap-6">
        <h2 class="display-md" data-split set:html={em(p.titluGalerie)} />
        <p class="text-sm text-muted" data-reveal>{gallery.length} fotografii</p>
      </div>
      <Gallery items={gallery} />
    </div>
  </section>

  <VoucherBand />
  <CTASection image={photo(p.pozaFinal)} title={em(p.titluFinal)} text={p.textFinal} />
</BaseLayout>
