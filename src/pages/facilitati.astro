---
import { Image } from 'astro:assets';
import { Sparkles, Check, Flower2 } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import FacilityGrid from '../components/FacilityGrid.astro';
import CTASection from '../components/CTASection.astro';
import { photo } from '../lib/photos';
import { facilitati as f, em } from '../lib/continut';
import { icon } from '../lib/icons';

const p = f.pagina;
---

<BaseLayout title={p.titluSeo} description={p.descriereSeo} image={photo(p.poza)}>
  <PageHero
    eyebrow={p.eticheta}
    crumb="Facilități"
    title={em(p.titlu, 'text-brass-300')}
    subtitle={p.subtitlu}
    image={photo(p.poza)}
    alt="Grădina pensiunii, lângă râul Cerna"
  />

  <!-- LISTA COMPLETĂ -->
  <section class="bg-cream-100 py-24 md:py-36">
    <div class="container-x">
      <SectionHeading eyebrow="Pe scurt" title={em(p.titluLista)} size="md" class="mb-16" />
      <FacilityGrid />
    </div>
  </section>

  <!-- SPA -->
  <section class="grain relative overflow-hidden bg-forest-900 py-24 text-cream-50 md:py-36">
    <div class="container-x grid items-center gap-16 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="eyebrow eyebrow-light" data-reveal>{f.spa.eticheta}</p>
        <h2 class="display-lg mt-6" data-split set:html={em(f.spa.titlu, 'text-brass-300')} />
        <p class="mt-8 max-w-xl text-lg text-cream-100/70" data-reveal>{f.spa.text}</p>
      </div>
      <div class="lg:col-span-4 lg:col-start-9" data-reveal>
        <div class="relative flex aspect-square flex-col items-center justify-center rounded-full border border-cream-100/15 text-center">
          <Sparkles size={30} stroke-width={1.2} class="text-brass-300" />
          <p class="mt-6 font-serif text-7xl leading-none">{f.spa.pret}</p>
          <p class="mt-2 font-serif text-2xl italic text-brass-300">{f.spa.unitate}</p>
          <p class="mt-3 text-[0.65rem] font-bold uppercase tracking-[0.2em] text-cream-100/70">{f.spa.detaliu}</p>
          <span class="absolute inset-4 rounded-full border border-dashed border-cream-100/10"></span>
        </div>
      </div>
    </div>
  </section>

  <!-- MAGIC GARDEN -->
  <section class="bg-cream-100 py-24 md:py-36">
    <div class="container-x grid items-center gap-16 lg:grid-cols-12">
      <div class="grid grid-cols-2 gap-4 lg:col-span-7">
        <div class="col-span-2 aspect-[16/10] overflow-hidden rounded-[1.5rem]" data-reveal-img>
          <Image src={photo(f.gradina.poza1)} alt="Grădina pensiunii, cu sălcii și flori" widths={[640, 1024, 1400]} sizes="(min-width: 1024px) 56vw, 100vw" class="img-cover" />
        </div>
        <div class="aspect-square overflow-hidden rounded-[1.5rem]" data-reveal-img data-delay="0.1">
          <Image src={photo(f.gradina.poza2)} alt="Colț din grădina pensiunii" widths={[400, 700]} sizes="(min-width: 1024px) 28vw, 50vw" class="img-cover" />
        </div>
        <div class="aspect-square overflow-hidden rounded-[1.5rem]" data-reveal-img data-delay="0.2">
          <Image src={photo(f.gradina.poza3)} alt="Peluza grădinii" widths={[400, 700]} sizes="(min-width: 1024px) 28vw, 50vw" class="img-cover" />
        </div>
      </div>
      <div class="lg:col-span-5 lg:pl-8">
        <p class="eyebrow" data-reveal><Flower2 size={14} /> {f.gradina.eticheta}</p>
        <h2 class="display-md mt-6" data-split set:html={em(f.gradina.titlu)} />
        <p class="lead mt-8" data-reveal>{f.gradina.textMare}</p>
        <p class="mt-5 text-muted" data-reveal>{f.gradina.text}</p>
      </div>
    </div>
  </section>

  <!-- RÂUL CERNA -->
  <section class="bg-cream-100 pb-24 md:pb-36">
    <div class="container-x grid items-center gap-16 lg:grid-cols-12">
      <div class="order-2 lg:order-1 lg:col-span-5 lg:pr-8">
        <p class="eyebrow" data-reveal>{f.rau.eticheta}</p>
        <h2 class="display-md mt-6" data-split set:html={em(f.rau.titlu)} />
        <p class="lead mt-8" data-reveal>{f.rau.text}</p>
        <ul class="mt-10 space-y-4" data-reveal>
          {f.rau.puncte.filter(Boolean).map((x) => <li class="flex items-center gap-4"><Check size={22} stroke-width={1.3} class="text-brass-600" /> {x}</li>)}
        </ul>
      </div>
      <div class="order-1 grid grid-cols-5 gap-4 lg:order-2 lg:col-span-7">
        <div class="col-span-3 aspect-[3/4] overflow-hidden rounded-[1.5rem]" data-reveal-img>
          <Image src={photo(f.rau.poza1)} alt="Zona de plajă de pe malul Cernei" widths={[480, 800]} sizes="(min-width: 1024px) 34vw, 60vw" class="img-cover" />
        </div>
        <div class="col-span-2 mt-20 aspect-[3/4] overflow-hidden rounded-[1.5rem]" data-reveal-img data-delay="0.15">
          <Image src={photo(f.rau.poza2)} alt="Malul râului Cerna" widths={[360, 600]} sizes="(min-width: 1024px) 22vw, 40vw" class="img-cover" />
        </div>
      </div>
    </div>
  </section>

  <!-- PRACTIC -->
  <section class="border-t border-forest-900/10 bg-cream-50 py-24 md:py-36">
    <div class="container-x">
      <SectionHeading eyebrow="Practic" title={em(f.practic.titlu)} size="md" />
      <div class="mt-16 grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
        {
          f.practic.lista.map((x) => ({ icon: icon(x.icon), title: x.titlu, text: x.text })).map((f, i) => (
            <div class="border-t border-forest-900/15 pt-8" data-reveal data-delay={(i % 3) * 0.07}>
              <f.icon size={28} stroke-width={1.2} class="text-brass-600" />
              <h3 class="mt-6 font-serif text-2xl">{f.title}</h3>
              <p class="mt-3 text-muted">{f.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CTASection image={photo(p.pozaFinal)} />
</BaseLayout>
